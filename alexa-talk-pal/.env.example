# Copy to .env and fill in real values. .env is gitignored — never commit it.

# OpenRouter (architecture.md §8) — key with a $0 spend limit set in the
# OpenRouter dashboard (Settings > Keys).
OPENROUTER_API_KEY=

# Alexa Skill ID (architecture.md §4.2/§9) — used to check the request's
# `session.application.applicationId` during signature verification, so a
# signed request for a *different* skill can't be replayed against this relay.
ALEXA_SKILL_ID=

# OpenRouter model slug to call for the :free tier. Picked from real,
# timed measurements on the netbook (ADR 0011) -- liquid/lfm-2.5-2.6b:free
# was the only candidate that didn't 429 under load, and comfortably beats
# the 8s Alexa deadline. Re-measure with relay/measure_latency.py if this
# ever needs revisiting (free catalog churns, architecture.md §8.2).
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# Secondary OpenRouter model slug the relay retries once against if the
# primary OPENROUTER_MODEL returns 429 (architecture.md §5.2/§8.2). At most
# one fallback attempt -- never retry-loop, failed requests still burn quota.
# openrouter/free (ADR 0011) is the free-models router -- it routes to
# whichever free provider currently has capacity, which is exactly the
# 429-under-load failure mode larger candidate models hit in testing.
OPENROUTER_FALLBACK_MODEL=openrouter/free

# Local daily request cap enforced by the relay's own quota guard, as a
# safety margin under OpenRouter's free-tier daily limit. Default: 45 --
# deliberately conservative; the account's actual cap is 1,000/day (the
# $10 lifetime credit is already applied, ADR 0011), so this is a
# runaway-loop safety margin, not a reflection of real remaining headroom.
DAILY_CAP=45

# Debug-only: when truthy (1/true/yes/on), skips Alexa signature
# verification entirely. MUST be unset or false in any real deployment --
# this exists solely for local/dev testing against hand-built fake request
# bodies (architecture.md §11 Phase 1/2). Never set this on the deployed
# service once the Alexa skill is wired to the real endpoint.
DEBUG_SKIP_SIGNATURE=
